# Mongo (used by docker-compose to set root creds; backend connects with these too)
MONGO_ROOT_USER=tadbor
MONGO_ROOT_PASSWORD=tadbor_dev_password

# LLM provider used ONLY by the offline generation pipeline (backend/internal/generation)
LLM_API_URL=https://api.your-llm-provider.com/v1/generate
LLM_API_KEY=

# Embedding provider used ONLY by the offline ingestion pipeline
# (backend/internal/embedding, backend/internal/ingestion).
# api-inference.huggingface.co is retired; the current host is router.huggingface.co.
# The model id lives in the URL, so swapping models needs no code change.
# Key: huggingface.co/settings/tokens/new -> "Inference Providers" permission.
EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-m3/pipeline/feature-extraction
EMBEDDING_API_KEY=

# Mobile app points at the backend directly (not through docker) when running on a device/simulator.
# Use your machine's LAN IP, not localhost, when testing on a physical device.
MOBILE_API_URL=http://localhost:8080

# Shared password for the reviewer dashboard (web/app/admin) and for everything
# the API serves under /internal. Pick your own; leave it unset and /internal
# answers 503 rather than opening up. Changing it invalidates open sessions.
REVIEWER_PASSWORD=
